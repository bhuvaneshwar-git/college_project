server {
    listen 80;
    server_name localhost;

    ############################################################
    # 1️⃣ FRONTEND (React + Vite build)
    ############################################################
    root /var/www/Virtual-os/frontend;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    ############################################################
    # 2️⃣ BACKEND API (Node.js + Express)
    # Example: http://your-ip/api/start-container
    ############################################################
    location /api/ {
        proxy_pass http://127.0.0.1:3001/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    ############################################################
    # 3️⃣ noVNC – Ubuntu Container
    ############################################################
	location /vnc/ubuntu/ {
    	proxy_pass http://127.0.0.1:6081/;
    	proxy_http_version 1.1;

    	# WebSocket support
    	proxy_set_header Upgrade $http_upgrade;
    	proxy_set_header Connection "upgrade";

    	proxy_set_header Host $host;
    	proxy_set_header X-Real-IP $remote_addr;

    	# IMPORTANT for noVNC
    	proxy_read_timeout 86400;
    	proxy_send_timeout 86400;
	}

    ############################################################
    # 4️⃣ noVNC – Kali Container
    ############################################################
    location /vnc/kali/ {
        proxy_pass http://127.0.0.1:6080/;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    ############################################################
    # 5️⃣ noVNC – Parrot Container
    ############################################################
    location /vnc/parrot/ {
        proxy_pass http://127.0.0.1:6082/;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
    
	location = /websockify {
    	proxy_pass http://127.0.0.1:6081/websockify;
    	proxy_http_version 1.1;

    	proxy_set_header Upgrade $http_upgrade;
    	proxy_set_header Connection "upgrade";
    	proxy_set_header Host $host;

    	proxy_read_timeout 86400;
	}
}
